GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=30000

# Shared stock records: preserve this directory when updating the Oracle app.
STOCK5_DATA_DIR=data
# Set an existing shared password here; empty uses the legacy default.
STOCK5_PASSWORD=
# Serverless deployment requires a persistent Redis/KV store.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Oracle server: set to kis and keep the KIS credentials only in .env.local or the server environment.
# Vercel: do not add KIS credentials. Vercel always uses Naver/Yahoo fallback sources.
MARKET_DATA_PROVIDER=kis
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_WS_URL=ws://ops.koreainvestment.com:21000
KIS_DEFAULT_US_EXCHANGE=NAS
KIS_US_EXCHANGE_OVERRIDES={"TSLA":"NAS","AAPL":"NAS","MSFT":"NAS","NVDA":"NAS","GOOGL":"NAS","META":"NAS"}
